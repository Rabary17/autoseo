 1 file changed, 12 insertions(+), 3 deletions(-)

diff --git a/frontend/monauto/app/(fr)/page.tsx b/frontend/monauto/app/(fr)/page.tsx
index 3abc2ce..ede059b 100644
--- a/frontend/monauto/app/(fr)/page.tsx
