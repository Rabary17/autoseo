        "prix {base}",
        "{base} tarif",
        "combien coute {base}",
        "{base} périodicité",
        "{label} {marque} prix"
      ],
      "note_fields": [
        {
          "type": "range",
          "min_field": "prix_ttc_min",
          "max_field": "prix_ttc_max",
          "template": "prix {min}-{max}€ TTC"
        },
        {
          "type": "value",
          "field": "temps_mo",
          "template": "MO {value} min",
          "strip_suffix_regex": "\\s*min\\.?$"
        },
        {
          "type": "value",
          "field": "motorisation"
        }
      ]
    },
    {
      "id": "M2a",
      "label": "M2 — Codes défaut OBD",
      "type": "single_entity",
      "source_glob": "codes-obd-*.json",
      "field": "code",
      "base_template": "code {value}",
      "silo_default": "Pannes & diagnostic",
      "sous_cocon_default": "Codes défaut OBD",
      "intention": "Info",
      "variantes_templates": [
        "{value}",
        "{value} signification",
        "defaut {value}",
        "{value} symptomes",
        "{value} solution",
        "{value} reparation"
      ],
      "note_fields": [
        {
          "type": "value",
          "field": "libelle"
        }
      ]
    },
    {
      "id": "M2b",
      "label": "M2 — Voyants tableau de bord",
      "type": "single_entity",
      "source_glob": "pannes-*voyant*.json",
      "field": "voyant",
      "strip_parens": true,
      "template_unless_contains": "voyant",
      "base_template": "voyant {value}",
      "silo_default": "Pannes & diagnostic",
      "sous_cocon_default": "Voyants tableau de bord",
      "intention": "Info",
      "variantes_templates": [
        "{base} allumé",
        "{base} que faire",
        "signification {base}",
        {
          "template": "{base} {couleur}",
          "requires_field": "couleur"
        }
      ],
      "note_fields": [
        {
          "type": "value",
          "field": "signification"
        }
      ]
    },
    {
      "id": "M3",
      "label": "M3 — Fiches modèle",
      "type": "entity_angles",
      "source_glob": "marques-modeles-fiabilite-*.json",
      "field": "modele",
      "strip_parens": true,
      "min_entity_length": 3,
      "silo_default": "Marques & modèles",
      "note_fields": [
        {
          "type": "first_nonempty",
          "fields": [
            "pannes_courantes",
            "score_fiabilite"
          ]
        }
      ],
      "angles": [
        {
          "suffix_template": "{entity} fiabilité",
          "sous_cocon": "Fiabilité par modèle",
          "intention": "Info",
          "variantes_templates": [
            "{entity} fiabilité",
            "{entity} fiable ou pas",
            "avis fiabilité {entity}"
          ]
        },
        {
          "suffix_template": "{entity} problèmes",
          "sous_cocon": "Pannes par modèle",
          "intention": "Info",
          "variantes_templates": [
            "{entity} problèmes",
            "{entity} pannes fréquentes",
            "{entity} problèmes connus"
          ]
        },
        {
          "suffix_template": "{entity} entretien prix",
          "sous_cocon": "Coûts & entretien par modèle",
          "intention": "Info",
          "variantes_templates": [
            "{entity} coût entretien",
            "entretien {entity} prix",
            "{entity} budget entretien"
          ]
        },
        {
          "suffix_template": "{entity} occasion",
          "sous_cocon": "Achat occasion par modèle",
          "intention": "Commercial",
          "variantes_templates": [
            "{entity} occasion",
            "{entity} quelle version choisir",
            "{entity} année à éviter"
          ]
        }
      ]
    },
    {
      "id": "M4",
      "label": "M4 — Pièce × Marque",
      "type": null,
      "source_glob": "pieces-*famille*.json",
      "silo_default": "Pièces détachées & accessoires",
      "intention": "Commercial",
      "note_fields": [
        {
          "type": "first_nonempty",
          "fields": [
            "prix_indicatif",
            "specs_notes"
          ]
        }
      ],
      "sub_builders": [
        {
          "type": "cross",
          "field_a": "famille",
          "label_mode": "identity",
          "strip_field_a": true,
          "field_b_list": "equipementiers_reconnus",
          "sous_cocon_default": "Pièces & équipementiers",
          "variantes_templates": [
            "{base} prix",
            "{base} avis",
            "meilleur {label} {b}"
          ]
        },
        {
          "type": "paired_versus",
          "entity_field": "famille",
          "list_field": "equipementiers_reconnus",
          "base_template": "{e1} vs {e2} {entity}",
          "sous_cocon_default": "Comparatifs équipementiers",
          "variantes_templates": [
            "{e1} ou {e2} {entity}",
            "comparatif {entity} {e1} {e2}",
            "meilleur {entity}"
          ]
        }
      ]
    },
    {
      "id": "M6",
      "label": "M6 — Démarche × Cas",
      "type": "single_entity",
      "source_glob": "carte-grise-*demarche*.json",
      "field": "demarche",
      "strip_parens": true,
      "template_unless_contains": "carte grise",
      "base_template": "{value} carte grise",
      "silo_default": "Carte grise & démarches",
      "intention": "Info",
      "sous_cocon_match_on": "value",
      "sous_cocon_rules": [
        {
          "contains": [
            "controle technique"
          ],
          "label": "Contrôle technique"
        },
        {
          "contains": [
            "immatricul",
            "importe",
            "plaque",
            " ww",
            "sans papiers"
          ],
          "label": "Immatriculation & import"
        },
        {
          "contains": [
            "taxe",
            "exoneration",
            "malus"
          ],
          "label": "Malus & taxes"
        },
        {
          "contains": [
            "changement de titulaire",
            "succession",
            "donation",
            "divorce",
            "reprise du vehicule",
            "reprise-vente",
            "location longue duree",
            "societe",
            "co-titularite",
            "saisie judiciaire"
          ],
          "label": "Changement de titulaire"
        },
        {
          "contains": [
            "cession",
            "vente",
            "non-gage",
            "histovec",
            "vehicule gage"
          ],
          "label": "Cession & achat"
        },
        {
          "contains": [
            "duplicata",
            "rectification",
            "changement d'adresse",
            "changement de nom",
            "changement de departement",
            "changement de puissance",
            "changement de carrosserie",
            "modification du nombre de places",
            "collection"
          ],
          "label": "Duplicata & modifications"
        }
      ],
      "sous_cocon_default": "Duplicata & modifications",
      "variantes_templates": [
        "{value} prix",
        "{value} délai",
        "{value} documents",
        "{value} en ligne"
      ],
      "note_fields": [
        {
          "type": "value",
          "field": "cout_indicatif",
          "template": "coût {value}"
        },
        {
          "type": "value",
          "field": "delai_legal",
          "template": "délai {value}"
        }
      ]
    },
    {
      "id": "M7",
      "label": "M7 — Itinéraires road trip",
      "type": "entity_angles",
      "source_glob": "roadtrips-destinations-*.json",
      "field": "pays",
      "dedup_by_entity": true,
      "silo_default": "Road trips & voyage auto",
      "note_fields": [
        {
          "type": "first_nonempty",
          "fields": [
            "prix_indicatif",
            "systeme_peage"
          ]
        }
      ],
      "angles": [
        {
          "suffix_template": "road trip {entity}",
          "sous_cocon": "Destinations road trip",
          "intention": "Info",
          "variantes_templates": [
            "road trip {entity} itinéraire",
            "road trip {entity} combien de jours",
            "voyage voiture {entity}"
          ]
        },
        {
          "suffix_template": "péage {entity}",
          "sous_cocon": "Péages & vignettes",
          "intention": "Info",
          "variantes_templates": [
            "péage {entity} prix",
            "autoroute {entity} tarif",
            "coût péage {entity}"
          ]
        },
        {
          "suffix_template": "vignette {entity}",
          "sous_cocon": "Péages & vignettes",
          "intention": "Info",
          "variantes_templates": [
            "vignette {entity} prix",
            "vignette autoroute {entity}",
            "où acheter vignette {entity}"
          ]
        }
      ]
    },
    {
      "id": "M5",
      "label": "M5 — Comparatifs \"Versus\"",
      "type": "grouped_versus",
      "source_glob": "marques-modeles-fiabilite-*.json",
      "entity_field": "modele",
      "strip_parens": true,
      "min_entity_length": 3,
      "group_map_file": "segments-modeles.json",
      "silo_default": "Essais & comparatifs",
      "intention": "Commercial",
      "base_template": "{e1} vs {e2}",
      "variantes_templates": [
        "{e1} ou {e2}",
        "comparatif {e1} {e2}",
        "{e1} vs {e2} lequel choisir",
        "{e1} {e2} différences"
      ],
      "sous_cocon_template": "Comparatifs face-à-face"
    }
  ]
}